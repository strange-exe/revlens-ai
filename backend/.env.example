# RevLens AI backend: copy to .env and fill in. Never commit .env.

# "dev" allows a local SQLite fallback when DATABASE_URL is empty. Anything else (default) requires DATABASE_URL.
ENV=dev

# Supabase: use the *Session pooler* URI (IPv4). The direct db.<ref>.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Required, at least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini: reply drafts, and classification when no fine-tuned model is loaded
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fine-tuned classifier (Phase 3, optional). See ml/README.md, step 8.
# MODEL_DIR=model
# MODEL_URL=            # private zip, downloaded at build time by `python -m scripts.fetch_model`
# MODEL_URL_TOKEN=      # bearer token, if MODEL_URL needs one
# MODEL_THREADS=1
